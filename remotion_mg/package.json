{
  "name": "nandarou-remotion-mg",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "remotion studio",
    "still": "remotion still C13AttentionFlow out/c13_styleframe.png --frame=238",
    "render:c13": "remotion render C13AttentionFlow out/c13_attention_flow.mp4",
    "typecheck": "tsc --noEmit",
    "render:scenes": "remotion render JsonScenes out/json_scenes_demo.mp4",
    "still:scenes": "remotion still JsonScenes out/json_scenes_still.png",
    "render:telops": "remotion render TelopOverlay out/ep01_telops_overlay.mov --codec=prores --prores-profile=4444 --pixel-format=yuva444p10le --image-format=png",
    "render:telops:sample": "remotion render TelopOverlay out/telop_overlay_sample.mov --frames=3880-3960 --codec=prores --prores-profile=4444 --pixel-format=yuva444p10le --image-format=png",
    "telops:json": "cd .. && python3 conte2telops.py 第1回_コンテ表_v1.xlsx remotion_mg/data/ep01_telops.json",
    "render:telops:p0": "remotion render TelopOverlay out/ep01_P0_telops.mov --props='{\"part\":\"P0\"}' --codec=prores --prores-profile=4444 --pixel-format=yuva444p10le --image-format=png",
    "render:telops:p1": "remotion render TelopOverlay out/ep01_P1_telops.mov --props='{\"part\":\"P1\"}' --codec=prores --prores-profile=4444 --pixel-format=yuva444p10le --image-format=png",
    "render:telops:p2": "remotion render TelopOverlay out/ep01_P2_telops.mov --props='{\"part\":\"P2\"}' --codec=prores --prores-profile=4444 --pixel-format=yuva444p10le --image-format=png",
    "render:telops:p3": "remotion render TelopOverlay out/ep01_P3_telops.mov --props='{\"part\":\"P3\"}' --codec=prores --prores-profile=4444 --pixel-format=yuva444p10le --image-format=png",
    "render:telops:p4": "remotion render TelopOverlay out/ep01_P4_telops.mov --props='{\"part\":\"P4\"}' --codec=prores --prores-profile=4444 --pixel-format=yuva444p10le --image-format=png",
    "render:telops:p5": "remotion render TelopOverlay out/ep01_P5_telops.mov --props='{\"part\":\"P5\"}' --codec=prores --prores-profile=4444 --pixel-format=yuva444p10le --image-format=png"
  },
  "dependencies": {
    "@fontsource/noto-sans-jp": "^5.2.9",
    "@fontsource/oswald": "^5.2.8",
    "@fontsource/shippori-mincho": "^5.2.8",
    "@remotion/animation-utils": "4.0.489",
    "@remotion/captions": "4.0.489",
    "@remotion/cli": "^4.0.0",
    "@remotion/effects": "4.0.489",
    "@remotion/fonts": "4.0.489",
    "@remotion/google-fonts": "^4.0.489",
    "@remotion/layout-utils": "4.0.489",
    "@remotion/light-leaks": "4.0.489",
    "@remotion/lottie": "4.0.489",
    "@remotion/mcp": "4.0.489",
    "@remotion/media-utils": "4.0.489",
    "@remotion/motion-blur": "4.0.489",
    "@remotion/noise": "4.0.489",
    "@remotion/openai-whisper": "4.0.489",
    "@remotion/paths": "4.0.489",
    "@remotion/sfx": "4.0.489",
    "@remotion/shapes": "4.0.489",
    "@remotion/starburst": "4.0.489",
    "@remotion/studio": "4.0.489",
    "@remotion/transitions": "4.0.489",
    "@remotion/zod-types": "4.0.489",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "remotion": "^4.0.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "typescript": "^5.4.0"
  }
}
